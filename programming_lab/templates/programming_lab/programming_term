    <div class="card shadow mb-4">


        <div class="card-header bg-dark text-white">

            Programming Terminal

        </div>


        <div class="card-body bg-dark text-white p-0">

            <div
                id="terminal"
                style="
                    height: 450px;
                    width: 100%;
                    background: #000;
                    padding: 15px;
                "
            ></div>

        </div>


    </div>




    <div class="card shadow mb-4">


        <div class="card-header">

            Output Console

        </div>


        <div class="card-body">

            <pre>

            {{ output }}

