</div>


<!-- XTERM.JS -->

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/xterm/css/xterm.css"
>

<script
    src="https://cdn.jsdelivr.net/npm/xterm/lib/xterm.js">
</script>


<script>

    const terminal = new Terminal({

        cursorBlink: true,

        fontSize: 15,

        theme: {

            background: "#000000",

            foreground: "#ffffff"

        }

    });


    terminal.open(
        document.getElementById("terminal")
    );


    terminal.write(
        "\r\nConnecting to Docker Programming Lab...\r\n"
    );


    const protocol =
        window.location.protocol === "https:"
            ? "wss://"
            : "ws://";


    const socket = new WebSocket(

        protocol
        +
        window.location.host
        +
        "/ws/programming-terminal/"

    );


    socket.onopen = function() {

        terminal.write(
            "\r\nConnected.\r\n\r\n"
        );

    };


    socket.onmessage = function(event) {

        const data = JSON.parse(
            event.data
        );


        if (data.output) {

            terminal.write(
                data.output
            );

        }

    };


    socket.onclose = function() {

        terminal.write(
            "\r\n\r\nConnection closed.\r\n"
        );

    };


    socket.onerror = function(error) {

        terminal.write(
            "\r\nTerminal connection error.\r\n"
        );

        console.error(
            "WebSocket error:",
            error
        );

    };


    terminal.onData(function(data) {

        if (
            socket.readyState ===
            WebSocket.OPEN
        ) {

            socket.send(
                JSON.stringify({

                    input: data

                })
            );

        }

    });

</script>


